NODE_ENV=development
PORT=3000
HOST=127.0.0.1
SITE_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/pioneer
JWT_SECRET=replace-with-a-long-random-secret-before-production
ALLOW_PUBLIC_REGISTRATION=false
RECAPTCHA_SITE_KEY=your-google-recaptcha-v3-site-key
RECAPTCHA_SECRET_KEY=your-google-recaptcha-v3-secret-key
RECAPTCHA_MIN_SCORE=0.5
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@your-domain.com
SMTP_PASS=your-godaddy-mailbox-password
SMTP_FROM="Pioneer Decor <admin@your-domain.com>"
