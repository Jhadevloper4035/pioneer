<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/images/favicon/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Pioneer" />
    <link rel="manifest" href="/images/favicon/site.webmanifest" />
    <link rel="stylesheet" href="/assets/css/bootstrap.min.css" />
    <title><%= pageTitle %> | <%= appName %></title>
    <style>
      :root {
        --pioneer-accent: #c98553;
        --pioneer-accent-dark: #a8653b;
        --pioneer-sidebar: #101a2b;
        --pioneer-sidebar-end: #17243a;
        --bs-primary: var(--pioneer-accent);
        --bs-primary-rgb: 201, 133, 83;
        --bs-link-color: #a8653b;
        --bs-link-hover-color: #7e492a;
      }

      body {
        min-height: 100vh;
        background: #f5f6f8;
        color: #182230;
        font-family: var(--template-font, "Maison Neue", sans-serif);
      }

      .admin-shell { min-height: 100vh; }

      .btn-primary {
        --bs-btn-bg: var(--pioneer-accent);
        --bs-btn-border-color: var(--pioneer-accent);
        --bs-btn-hover-bg: var(--pioneer-accent-dark);
        --bs-btn-hover-border-color: var(--pioneer-accent-dark);
        --bs-btn-active-bg: var(--pioneer-accent-dark);
        --bs-btn-active-border-color: var(--pioneer-accent-dark);
      }

      .btn-outline-primary {
        --bs-btn-color: var(--pioneer-accent-dark);
        --bs-btn-border-color: var(--pioneer-accent);
        --bs-btn-hover-bg: var(--pioneer-accent);
        --bs-btn-hover-border-color: var(--pioneer-accent);
        --bs-btn-active-bg: var(--pioneer-accent-dark);
        --bs-btn-active-border-color: var(--pioneer-accent-dark);
      }

      .admin-sidebar {
        width: 256px;
        color: #f8fafc;
        background: linear-gradient(180deg, var(--pioneer-sidebar), var(--pioneer-sidebar-end));
        border-right: 1px solid rgba(255, 255, 255, 0.12);
      }

      .admin-sidebar .offcanvas-header { color: inherit; }

      .admin-brand {
        display: grid;
        gap: 10px;
        color: inherit;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
      }

      .admin-brand img { display: block; width: 148px; height: auto; }

      .admin-nav .nav-link,
      .admin-nav-toggle {
        width: 100%;
        border: 0;
        border-radius: var(--bs-border-radius);
        color: #d7e0ed;
        background: transparent;
        text-align: left;
      }

      .admin-nav .nav-link:hover,
      .admin-nav .nav-link:focus-visible,
      .admin-nav-toggle:hover,
      .admin-nav-toggle:focus-visible {
        color: #ffffff;
        background: rgba(201, 133, 83, 0.22);
      }

      .admin-nav-toggle {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 16px;
      }

      .admin-nav-toggle::after { content: "+"; font-size: 18px; }
      .admin-nav-toggle[aria-expanded="true"]::after { content: "−"; }

      .admin-nav-submenu {
        margin: 4px 0 0 10px;
        padding-left: 10px;
        list-style: none;
        border-left: 1px solid rgba(255, 255, 255, 0.18);
      }

      .admin-nav-submenu .nav-link { padding-left: 12px; }
      .admin-main { min-width: 0; flex: 1; }

      .admin-topbar {
        min-height: 72px;
        border-top: 3px solid var(--pioneer-accent);
        border-bottom: 1px solid #dee2e6;
        background: #ffffff;
      }

      .admin-topbar h1 { margin: 0; font-size: clamp(1.35rem, 2vw, 1.75rem); }
      .admin-content { padding: 1.5rem; }
      .admin-status { color: #667085; }
      .admin-status.is-error { color: #b42318; }

      .dashboard-welcome { background: linear-gradient(135deg, #ffffff, #f8ede6); }
      .dashboard-welcome .text-uppercase,
      .dashboard-stat span { color: var(--pioneer-accent-dark); }
      .dashboard-stat { color: inherit; transition: transform 0.2s ease, box-shadow 0.2s ease; }
      .dashboard-stat:hover { transform: translateY(-2px); box-shadow: var(--bs-box-shadow) !important; }

      .admin-table-scroll {
        max-height: 560px;
        overflow: auto;
      }

      .admin-table-scroll thead th {
        position: sticky;
        top: 0;
        z-index: 1;
        background: var(--bs-body-bg);
      }

      .admin-mobile-navbar {
        min-height: 64px;
        background: var(--pioneer-sidebar);
        border-bottom: 2px solid var(--pioneer-accent);
      }

      .admin-mobile-brand {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #ffffff;
        font-weight: 700;
        text-decoration: none;
      }

      .admin-mobile-brand img { width: 118px; height: auto; }
      .admin-mobile-brand span { padding-left: 10px; border-left: 1px solid rgba(255, 255, 255, 0.35); }

      @media (max-width: 991.98px) {
        .admin-sidebar { width: min(86vw, 320px); }
        .admin-content { padding: 1rem; }
      }
    </style>
  </head>
